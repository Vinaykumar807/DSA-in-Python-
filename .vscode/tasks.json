{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "py_compile",
                "${workspaceFolder}\\1st.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "compile and run",
            "type": "shell",
            "command": "python \"${workspaceFolder}\\1st.py\" < \"${workspaceFolder}\\input.txt\" > \"${workspaceFolder}\\output.txt\"",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}